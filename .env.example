# Copy to .env for local development. Never commit .env.

# "dev" enables the fake signed-in identity and the Mock model. Anything else
# requires real authentication, which the backend does not implement yet, so it refuses to start.
EDVEN_ENV=dev
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Fake identity used only when EDVEN_ENV=dev. Roles: Engineer, Manager.
EDVEN_DEV_EMAIL=dev@edvenswa.local
EDVEN_DEV_ROLES=Engineer,Manager

# Provider keys. A provider's models are offered only when its key is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where the CLI finds the backend. Must be https:// unless it is localhost.
EDVEN_API_URL=http://127.0.0.1:8787
